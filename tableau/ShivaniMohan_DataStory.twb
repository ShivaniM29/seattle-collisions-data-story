              <calculation class='tableau' formula='REPLACE(REPLACE(&#13;&#10;    IF CONTAINS([Location], &quot; BETWEEN &quot;)&#13;&#10;    THEN TRIM(SPLIT([Location], &quot; BETWEEN &quot;, 1))&#13;&#10;    ELSE TRIM(SPLIT([Location], &quot; AND &quot;, 1))&#13;&#10;    END,&#13;&#10;&quot;M L KING JR WR WAY S&quot;, &quot;MLK JR WAY S&quot;),&#13;&#10;&quot;M L KING JR ER WAY S&quot;, &quot;MLK JR WAY S&quot;)' />
            </column>
            <column caption='Road User' datatype='string' name='[Calculation_2552301524983809]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Pedestrian_Involved] = 1 THEN &quot;Pedestrian&quot; ELSE &quot;Cyclist&quot; END' />
