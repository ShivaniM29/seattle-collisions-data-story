  <worksheets>
    <worksheet name='Conditions'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Should SDOT focus its safety campaigns on bad-weather days or on clear nights?</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>SDOT should shift its safety campaigns and enforcement away from “drive carefully in the rain” messaging and toward </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>evenings and nights</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>, with a focus on </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>speeding</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>, which ties back to speeding being the top factor in severe crashes</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='SDOT_Collisions_Clean' name='federated.0vp66e207341pz1ftvevs1bo577n' />
          </datasources>
          <datasource-dependencies datasource='federated.0vp66e207341pz1ftvevs1bo577n'>
            <column caption='%Severe' datatype='real' default-format='p0.0%' name='[Calculation_2552301550727170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Severe]) / COUNT([Incident_Key])' />
